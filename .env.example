# LLM (provider-agnostic — same pattern as FitCrew AI)
LLM_MODEL=gemini/gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# MongoDB Atlas
MONGO_URI=your_mongodb_atlas_connection_string_here
MONGO_DB_NAME=jobshield_ai

# data.gov.in Open Government Data API (MCA Company Master Data)
# Register at https://data.gov.in -> Profile -> API key
DATA_GOV_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_BASE_URL=https://api.data.gov.in/resource

# Comma-separated resource ID(s) of the "Company Master Data" dataset(s).
# Find these by searching data.gov.in's catalog for "Company Master Data" —
# each dataset page shows its resource ID and an example request.
MCA_RESOURCE_IDS=

# Override only if backend/scripts/probe_mca.py shows different field names
# for the dataset you're using.
MCA_NAME_FIELD=company_name
MCA_CIN_FIELD=cin
MCA_TIMEOUT_SECONDS=20
